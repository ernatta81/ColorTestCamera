      "program": "${workspaceFolder}/led_gui.py",
      "console": "integratedTerminal"
    },
    {
      "name": "LED: elenca telecamere",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/led_test.py",
      "args": [
        "list"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "LED: seleziona ROI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/led_test.py",
      "args": [
        "roi",
        "--cam",
        "0"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "LED: live",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/led_test.py",
